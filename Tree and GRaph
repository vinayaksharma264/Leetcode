class Solution {
    public int makeConnected(int n, int[][] connections) {

        DisjointSet ds = new DisjointSet(n);

        int cntExtras = 0;

        for (int[] edge : connections) {

            int u = edge[0];
            int v = edge[1];

            if (ds.findUPar(u) == ds.findUPar(v)) {
                cntExtras++;
            } else {
                ds.unionBySize(u, v);
            }
        }

        int cntC = 0;

        for (int i = 0; i < n; i++) {
            if (ds.findUPar(i) == i) {
                cntC++;
            }
        }

        int requiredEdges = cntC - 1;

        if (cntExtras >= requiredEdges) {
            return requiredEdges;
        }

        return -1;
    }
}
